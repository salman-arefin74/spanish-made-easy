# Public Supabase project URL. Leave blank until that project exists.
VITE_SUPABASE_URL=

# Public anon key only.
# Never put the service-role key in a VITE_ variable or anywhere in frontend code.
# The service-role key bypasses Row Level Security.
VITE_SUPABASE_ANON_KEY=

# Public Cloudflare Turnstile site key. The secret belongs in the Supabase
# Auth captcha settings, not in this file.
VITE_TURNSTILE_SITE_KEY=

# Used only by `npm run seed`. Never prefix this with VITE_.
# Copy the secret key from Supabase → Project Settings → API Keys.
# It bypasses Row Level Security. Do not commit .env.
SUPABASE_SERVICE_ROLE_KEY=
